# ============================================================
# Семейный архив — переменные окружения
# Скопируй в .env и заполни СВОИ значения: cp .env.example .env
# Менять только то, что помечено «СМЕНИ!»
# ============================================================

# ---------- Домен / адрес сервера ----------
# Публичный домен или IP VPS. Используется для CORS и подписанных ссылок.
APP_URL=http://your-vps-ip-or-domain.ru

# ---------- PostgreSQL ----------
POSTGRES_USER=archive
POSTGRES_PASSWORD=СМЕНИ!-long-random-password-1
POSTGRES_DB=archive

# ---------- MinIO (S3) ----------
MINIO_ROOT_USER=archive
MINIO_ROOT_PASSWORD=СМЕНИ!-long-random-password-2

# ---------- JWT ----------
# Генерация: openssl rand -hex 32
JWT_SECRET=СМЕНИ!-openssl-rand-hex-32

# ---------- Начальный администратор ----------
# Создаётся автоматически при первом старте API.
# ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ: admin / admin
# В ПРОДАКШЕНЕ ОБЯЗАТЕЛЬНО СМЕНИТЬ ПАРОЛЬ!
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Администратор

# ---------- Подписанные (presigned) ссылки ----------
# Срок действия ссылки на оригинал в секундах (по умолчанию 1 час)
PRESIGNED_EXPIRY=3600

# ---------- Ограничения загрузки ----------
# Максимальный размер файла (байты). 500 МБ — для видео.
MAX_FILE_SIZE=524288000

# ---------- Корзина ----------
# Через сколько дней файлы из корзины удаляются физически (автоочистка)
TRASH_RETENTION_DAYS=30

# ---------- Пути (обычно не менять) ----------
S3_BUCKET=media
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1

# Публичный эндпоинт MinIO для presigned URL (браузер должен до него дотянуться).
# Если APP_URL=http://192.168.1.10, то S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000
# Если APP_URL=https://archive.example.ru, лучше проксировать MinIO через nginx.
# По умолчанию = http://minio:9000 (внутренний — НЕ РАБОТАЕТ снаружи).
S3_PUBLIC_ENDPOINT=http://your-vps-ip:9000